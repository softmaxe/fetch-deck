Output docs/assets/demo.gif

Set Shell "zsh"
Set FontSize 16
Set FontFamily "JetBrains Mono"
Set Width 1200
Set Height 720
Set Framerate 30
Set PlaybackSpeed 1
Set TypingSpeed 35ms
Set Theme { "name": "Catppuccin Mocha", "background": "#1e1e2e", "foreground": "#cdd6f4", "black": "#45475a", "brightBlack": "#585b70", "red": "#f38ba8", "brightRed": "#f37799", "green": "#a6e3a1", "brightGreen": "#89d88b", "yellow": "#f9e2af", "brightYellow": "#ebd391", "blue": "#89b4fa", "brightBlue": "#74a8fc", "magenta": "#f5c2e7", "brightMagenta": "#f2aede", "cyan": "#94e2d5", "brightCyan": "#6bd7ca", "white": "#a6adc8", "brightWhite": "#bac2de" }

Hide
Type "stty cols 120 rows 30 && docs/demo/run-demo.sh"
Enter
Sleep 2s
Show
Sleep 2s

Type "https://example.test/watch?v=fetchdeck"
Sleep 1s
Enter
Sleep 3s

Enter
Sleep 2s

Enter
Sleep 6s
Sleep 3s

Hide
Type "q"
Sleep 1s
